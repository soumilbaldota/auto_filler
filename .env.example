# ===========================================
# Auto Filler Configuration
# ===========================================

# Server Configuration
PORT=3000
WS_PORT=3001

# Google Account Credentials (for browser login)
# These are used to auto-login to Google for OAuth-based job applications
GOOGLE_EMAIL=your-email@gmail.com
GOOGLE_PASSWORD=your-password

# Job Search Configuration
# Default search query for finding job applications
SEARCH_QUERY=Summer 2026 software intern

# ATS (Applicant Tracking System) domains to search
# These are the job application platforms to look for
ATS_DOMAINS=lever.co,greenhouse.io,workday.com,myworkdayjobs.com,taleo.net,icims.com,smartrecruiters.com

# Simplify Extension
# Path to the unpacked Simplify browser extension
# Download from Chrome Web Store and extract to this location
SIMPLIFY_EXTENSION_PATH=./extensions/simplify

# Session Configuration
# Maximum number of concurrent browser sessions
MAX_CONCURRENT_SESSIONS=3

# VNC Configuration (for Docker deployment)
# These are used when running in Docker with VNC support
VNC_PORT=5900
NOVNC_PORT=6080
